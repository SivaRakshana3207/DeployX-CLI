# DeployX backend configuration.
# Copy to backend/.env and fill in your own values.
# NEVER commit a real key - this file must only ever hold placeholders.

# Address the CLI uses to reach the local backend.
DEPLOYX_BACKEND_URL=http://127.0.0.1:8000

# Fernet key used to encrypt provider tokens at rest.
# Generate one with:  python -m backend.crypto
DEPLOYX_ENCRYPTION_KEY=

# Shared secret that n8n must present as:
#   Authorization: Bearer <DEPLOYX_N8N_SERVICE_KEY>
DEPLOYX_N8N_SERVICE_KEY=
